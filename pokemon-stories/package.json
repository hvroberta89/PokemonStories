{
  "name": "pokemon-stories",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "data:import:poke5e": "node scripts/import-poke5e-reference-data.mjs",
    "data:migrate:poke5e": "node --env-file-if-exists=.env scripts/migrate-poke5e-reference-data-to-supabase.mjs",
    "data:translate:poke5e:hu": "node scripts/translate-poke5e-reference-data-to-hungarian.mjs",
    "data:translate:poke5e-tms:hu": "node scripts/translate-poke5e-technical-machines-to-hungarian.mjs",
    "data:download:pokemon-artwork": "node scripts/download-pokemon-artwork.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@supabase/supabase-js": "^2.111.0",
    "html-to-image": "^1.11.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.1",
    "@angular/cli": "^22.1.1",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
